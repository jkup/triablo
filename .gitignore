# No trailing slash: agent worktrees receive node_modules as a SYMLINK
# (worktree.symlinkDirectories), and the `node_modules/` form only matches
# real directories — `git add -A` in a worktree was staging the symlink.
node_modules
dist/
coverage/
*.log

# Generated content bundle (rebuilt by `npm run content:bake`).
# Never commit it: generated files are a merge-conflict magnet when many
# agents work in parallel.
packages/content/generated/

# Screenshot output from `npm run shot`. PNGs are throwaway diagnostics an
# agent Reads and discards; only their one-line text summaries get committed.
shots/

# Local, per-machine Claude Code overrides.
.claude/settings.local.json

# Agent worktrees. Each is a real git worktree, so `git add -A` in the primary
# checkout stages them as embedded repositories ("adding embedded git
# repository" warnings) and commits a bare gitlink pointing at a path that
# exists on one machine only. Observed 2026-08-07 while staging this very
# commit. Worktrees are created and removed by the dispatch loop; nothing here
# is ever a source artifact.
.claude/worktrees/

.DS_Store
