{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm ls *)",
      "Bash(npx tsx *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git push*)",
      "Bash(git worktree *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh workflow *)",
      "Bash(gh repo *)",
      "Bash(gh search *)",
      "Bash(gh cache *)",
      "Bash(gh browse *)",
      "Bash(gh auth status)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(mkdir -p *)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(npm publish*)",
      "Bash(gh secret *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>{let c=\"\";try{c=(JSON.parse(s).tool_input||{}).command||\"\"}catch(e){c=s}const mutates=/-X\\s*(DELETE|PUT|PATCH|POST)\\b/i.test(c);const sensitive=/branches\\/[^ ]*\\/protection|\\/actions\\/secrets|\\/collaborators|\\/actions\\/permissions/i.test(c);const lifecycle=/gh repo (delete|archive|rename|edit)\\b|gh workflow (disable|delete)\\b/i.test(c);if((mutates&&sensitive)||lifecycle){process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"ask\",permissionDecisionReason:\"Mutates branch protection, secrets, or repo/workflow lifecycle - the controls that make the gate meaningful. Reads are unaffected. Confirm before proceeding.\"}}))}})'",
            "statusMessage": "Checking gh command scope"
          }
        ]
      }
    ]
  }
}
