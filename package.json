{
  "name": "triablo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A single-player action RPG in the Diablo lineage, built by AI agents.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --no-inline-config",
    "test": "vitest run --coverage",
    "content:validate": "tsx packages/content/src/cli.ts",
    "content:bake": "tsx scripts/bake-content.ts",
    "dev": "npm run content:bake && vite --config packages/client/vite.config.ts",
    "shot": "tsx scripts/shot.ts",
    "sim": "tsx packages/sim/src/cli.ts",
    "sim:smoke": "tsx packages/sim/src/cli.ts smoke",
    "replay:check": "tsx packages/sim/src/cli.ts replay",
    "replay:bless": "tsx packages/sim/src/cli.ts replay --bless",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run content:validate && npm run sim:smoke && npm run replay:check"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
